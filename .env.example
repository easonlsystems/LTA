NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/link2ai
PUBLIC_BRAND_NAME=Link2AI
PUBLIC_BASE_URL=http://localhost:3000
APP_SECRET=replace-with-at-least-32-random-bytes

# Media / extraction
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
MEDIA_PROVIDER_URL=
MEDIA_PROVIDER_API_KEY=
MAX_DOWNLOAD_BYTES=262144000
EXTRACTION_TIMEOUT_MS=90000
AUDIO_EXTRACTION_TIMEOUT_MS=600000
TRANSCRIPTION_TIMEOUT_MS=600000

# ASR
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional legacy email-code auth (normal public sign-in uses email + password)
RESEND_API_KEY=
PUBLIC_EMAIL_LOGIN_ENABLED=false
AUTH_FROM_EMAIL=Link2AI <login@example.com>
SUPPORT_EMAIL=
FOUNDER_EMAIL=
AUTH_EMAIL_GLOBAL_LIMIT_15M=200
OAUTH_DCR_GLOBAL_LIMIT_HOUR=2000
DEV_SHOW_LOGIN_CODE=true

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_BASIC_VARIANT_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_TEST_MODE=true

# Operational
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=4
MCP_INLINE_WAIT_MS=25000
TRANSCRIPT_CACHE_HOURS=72

# OpenAI public plugin review/submission
# Set the challenge only after the submission portal issues it.
OPENAI_APPS_CHALLENGE=
# Dedicated reviewer credentials; configure both or neither. Password must be 16+ chars.
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
