{
  "name": "link2ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "start:api": "node dist/src/api/main.js",
    "start:worker": "node dist/src/worker/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.pure.json --pretty false && node test/pure.mjs && node test/reddit-share-schema.mjs && node test/quota.mjs && node test/billing.mjs && node test/mcp-smoke.mjs && node test/security.mjs && node test/founder-otp-schema.mjs && node test/runtime-smoke.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/fastify": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "fastify": "5.12.4",
    "pdfjs-dist": "5.4.149",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "zod": "4.5.4"
  }
}
